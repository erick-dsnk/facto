# Copy to .env, which is ignored. Never commit credentials.
# Local: 127.0.0.1. On Railway or any other host set HOST=0.0.0.0; Railway sets PORT itself.
HOST=127.0.0.1
PORT=3000
PIPELINE_MODE=fixture
# Required: choose a secret code and an absolute expiry before starting.
DEMO_JOIN_CODE=
DEMO_JOIN_EXPIRES_AT=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required only for PIPELINE_MODE=live. Keys stay on the server.
JEV_API_KEY=
EXA_API_KEY=
# Server-side key for the Deepgram ASR adapter (services/api/src/input/asr). Without an ASR adapter, audio.start fails with asr_unavailable.
DEEPGRAM_API_KEY=
# Set both for direct HTTPS/WSS, or terminate TLS at a trusted proxy. Leave both empty on Railway.
TLS_CERT_PATH=
TLS_KEY_PATH=
