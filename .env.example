# Copy to .env, which is ignored. Never commit credentials.
HOST=127.0.0.1
PORT=3000
PIPELINE_MODE=fixture
# Required: choose a secret code and an absolute expiry before starting.
DEMO_JOIN_CODE=
DEMO_JOIN_EXPIRES_AT=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required only for PIPELINE_MODE=live. Keys stay on the server.
JEV_API_KEY=
EXA_API_KEY=
# Set both for direct HTTPS/WSS, or terminate TLS at a trusted proxy.
TLS_CERT_PATH=
TLS_KEY_PATH=
