# Copy to .env, which is ignored. Never commit credentials.
# Local: 127.0.0.1. On any other host set HOST=0.0.0.0. On Railway, an unset HOST defaults to 0.0.0.0 and Railway sets PORT itself.
HOST=127.0.0.1
PORT=3000
PIPELINE_MODE=fixture
# Required: choose a secret code and an absolute expiry before starting.
DEMO_JOIN_CODE=
DEMO_JOIN_EXPIRES_AT=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required only for PIPELINE_MODE=live. Keys stay on the server.
JEV_API_KEY=
EXA_API_KEY=
# Speech recognition (services/api/src/input/asr): elevenlabs (default, Scribe v3 Live) or deepgram (nova-3).
# If the chosen provider has no key but the other one has, the server uses the other one and warns at startup.
# With neither key, audio.start fails with asr_unavailable.
ASR_PROVIDER=elevenlabs
# Server-side key for the ElevenLabs ASR adapter.
ELEVENLABS_API_KEY=
# Optional multimodal selector, independent of Jev. Off unless base URL AND model are set.
# OpenAI-compatible API root including /v1 (e.g. http://127.0.0.1:8080/v1).
# Enabling the iPhone's remote OCR setting sends the original image + OCR boxes to this provider.
# Images are transient, never persisted or added to debug feeds. Key is server-only; local servers may omit it.
OCR_VISION_BASE_URL=
OCR_VISION_MODEL=
OCR_VISION_API_KEY=
OCR_VISION_TIMEOUT_MS=12000
# Response budget; lower for small-context local models. 256..4000; default 1200.
OCR_VISION_MAX_TOKENS=1200
# Server-side key for the Deepgram ASR adapter (the fallback).
DEEPGRAM_API_KEY=
# Optional comma list of extra names for ElevenLabs keyterm prompting (at most 20 characters each), added to Facto, Hey Facto, Anthropic,
# Claude, Opus, Sonnet, Haiku, DeepSeek, OpenAI, ChatGPT, Gemini, Meta, Ray-Ban, Zelensky, Donbas and NATO.
ELEVENLABS_KEYTERMS=
# Optional comma list of extra names for Deepgram nova-3 keyterm prompting, added to Facto, Anthropic, Nvidia, Jensen Huang, Meta, Ray-Ban and OpenAI.
DEEPGRAM_KEYTERMS=
# Voice dimming: a final sentence more than ASR_DIM_DB (default 14, 0 = off) below the wearer's level, or under ASR_DIM_FLOOR_DBFS
# (default -60), is shown but not checked. ASR_ECHO_MS (default 800, 0 = off): after a spoken answer, words in the first this-many ms
# of the resumed stream are ignored, so the answer's tail is not transcribed. Empty uses the default.
ASR_DIM_DB=
ASR_DIM_FLOOR_DBFS=
ASR_ECHO_MS=
# A sentence that trails off joins the same speaker's next sentence within ASR_STITCH_MS (default 4000, 0 = no joining) and is checked once.
ASR_STITCH_MS=
# Optional Google Fact Check Tools key (sent in the X-Goog-Api-Key header). Without it the fact-check source is skipped.
GOOGLE_FACTCHECK_API_KEY=
# Set both for direct HTTPS/WSS, or terminate TLS at a trusted proxy. Leave both empty on Railway.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Proxy hops in front of every request, used for the per-client join limit. 0 when clients connect directly.
# On Railway it defaults to 1 (and HOST to 0.0.0.0); raise it only if another proxy such as a CDN sits in front.
TRUST_PROXY=0
# Debug only: 1 logs every final ASR result with per-word confidence (Deepgram) or logprob (ElevenLabs), which includes what bystanders said. Leave empty otherwise.
DEBUG_TRANSCRIPTS=
# Operator key (16+ characters) for GET /v1/debug/feed, sent as x-debug-key. Without it the feed is off and nothing is recorded, even with DEBUG_TRANSCRIPTS=1.
# The join code never opens the feed. Entries are purged when their session ends.
DEBUG_FEED_KEY=
