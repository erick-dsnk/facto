{
  "name": "facto-cloudflare-deploy",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types --config ../../wrangler.jsonc --include-env=false ./worker-configuration.d.ts",
    "typecheck": "npm run types && tsc --noEmit",
    "validate": "wrangler deploy --dry-run --config ../../wrangler.jsonc --outdir ./dist",
    "check": "npm run typecheck && npm run validate",
    "dev": "wrangler dev --config ../../wrangler.jsonc",
    "deploy": "wrangler deploy --config ../../wrangler.jsonc",
    "tail": "wrangler tail --config ../../wrangler.jsonc"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  }
}
