                <span data-action="click->suggestions#fillExample"
                  class="example badge badge-info desktop-only">09/05/24</span>
                <span data-action="click->suggestions#fillExample"
                  class="example badge badge-info">RULE</span>
                <span data-action="click->suggestions#fillExample"
