{
  "name": "actually-glasses",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env services/api/src/index.ts",
    "start": "tsx --env-file-if-exists=.env services/api/src/index.ts",
    "lint": "eslint packages services apps --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "evaluate": "tsx apps/console/evaluate.ts",
    "evaluate:live": "tsx --env-file-if-exists=.env apps/console/evaluate-live.ts",
    "evaluate:live:inprocess": "tsx --env-file-if-exists=.env apps/console/src/live/run.ts",
    "dev:glasses": "npm run dev --workspace=@actually/glasses",
    "build:glasses": "npm run build --workspace=@actually/glasses",
    "check:glasses": "npm run check --workspace=@actually/glasses",
    "evaluate:providers": "tsx --env-file-if-exists=.env apps/console/evaluate-providers.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.2.0",
    "compromise": "14.19.0",
    "exa-js": "2.28.0",
    "fastify": "5.12.8",
    "tldts": "7.0.19",
    "tsx": "4.20.6",
    "ws": "8.23.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.1",
    "@types/ws": "8.18.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "5.1.0"
  },
  "workspaces": [
    "apps/glasses"
  ]
}
