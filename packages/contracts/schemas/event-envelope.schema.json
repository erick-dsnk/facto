{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventSeq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "sessionEpoch": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "requestId": {
      "type": "string"
    },
    "claimId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": [
        "session.ready",
        "session.ended",
        "claim.detected",
        "claim.waiting",
        "claim.skipped",
        "claim.needs_confirmation",
        "claim.checking",
        "claim.result",
        "claim.superseded",
        "check.cancelled",
        "pipeline.error",
        "audio.ready",
        "audio.stopped",
        "transcript.partial",
        "transcript.final",
        "capture.request"
      ]
    },
    "serverAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "payload": {}
  },
  "required": [
    "schemaVersion",
    "eventId",
    "eventSeq",
    "sessionId",
    "sessionEpoch",
    "type",
    "serverAt",
    "payload"
  ],
  "additionalProperties": false,
  "description": "Version 1 server envelope. A claim.result payload conforms to claim-result.schema.json and includes requestId, claimId, revision. claim.waiting carries admissionAction=wait, reasonCode and ISO waitExpiresAt. claim.checking, claim.skipped and claim.needs_confirmation carry admissionAction and reasonCode, and optionally presentation, kind (skipped/needs_confirmation only), summary, route, subject and usage. capture.request carries reasonCode (voice_trigger) and asks the app to take one photo for OCR."
}
