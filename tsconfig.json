{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages/**/*.ts", "services/**/*.ts", "apps/**/*.ts"],
  "exclude": ["apps/landing/**"]
}
