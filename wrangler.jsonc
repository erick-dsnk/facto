// Cloudflare Worker + Container for the live backend (issue #43). Deploy steps: README.md, "Deploy (Cloudflare)".
// Run wrangler from deploy/cloudflare (it pins the wrangler version): npm run deploy.
// Relative paths in this file resolve from the repo root, where this file lives.
{
  "$schema": "./deploy/cloudflare/node_modules/wrangler/config-schema.json",

  // With the account's workers.dev subdomain this fixes the public URL:
  // https://actually-api.<subdomain>.workers.dev. Renaming it changes the URL.
  "name": "actually-api",
  "main": "./deploy/cloudflare/src/index.ts",
  // Must not be newer than the workerd bundled with the pinned wrangler (4.156.0 ships 2026-10-23).
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  // Durable Objects get no preview URLs, so keep them off to avoid a deploy warning.
  "preview_urls": false,
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "ApiContainer",
      // The Durable Object picks the image and instance size in ctx.container.start().
      // This setting cannot be changed after the first deploy.
      "scheduling_policy": "durable_object",
      "images": {
        // Exposed to the Durable Object as ctx.container.images.api. The build context is the repo root,
        // because the server reads apps/console/index.html and imports packages/contracts.
        "api": { "dockerfile": "./Dockerfile", "build_context": "." }
      }
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "ApiContainer" }],
    // A deploy resets the Durable Object right away, which closes open WebSockets (clients reconnect).
    // The container and its in-memory sessions keep running unless the image or config changed.
    "code_update_strategy": { "mode": "immediate" }
  },

  // Declares the Durable Object class (replaces "migrations"; the two cannot be combined).
  "exports": {
    "ApiContainer": { "type": "durable-object", "storage": "sqlite" }
  },

  // Non-secret settings. The Durable Object copies these and the secrets below into the container env.
  "vars": {
    "PIPELINE_MODE": "live",
    "TRUST_PROXY": "1",
    // Speech recognition: "elevenlabs" (Scribe v3 Live, needs ELEVENLABS_API_KEY) or "deepgram" (nova-3,
    // needs DEEPGRAM_API_KEY). If the chosen provider's key is missing, the other provider is used when its key is set.
    "ASR_PROVIDER": "elevenlabs",
    // Optional comma lists of extra names for keyterm prompting, added to each provider's built-in list. Empty adds nothing.
    // ElevenLabs (terms of at most 20 characters): Facto, Hey Facto, Anthropic, Claude, Opus, Sonnet, Haiku, DeepSeek, OpenAI,
    // ChatGPT, Gemini, Meta, Ray-Ban, Zelensky, Donbas, NATO. Deepgram: Facto, Anthropic, Nvidia, Jensen Huang, Meta, Ray-Ban, OpenAI.
    "ELEVENLABS_KEYTERMS": "",
    "DEEPGRAM_KEYTERMS": "",
    // Voice dimming: a final sentence more than ASR_DIM_DB below the wearer's level (or under ASR_DIM_FLOOR_DBFS) is shown but
    // not checked, so other tables do not use up checks. "0" turns dimming off. With the debug feed on, every sentence's level is an
    // asr.level entry. ASR_ECHO_MS: after a spoken answer, ignore words in the first this-many ms of the resumed stream ("0" = off).
    "ASR_DIM_DB": "20",
    "ASR_DIM_FLOOR_DBFS": "-60",
    "ASR_ECHO_MS": "800",
    // A sentence that trails off (comma, filler, "...", dangling "the/of/are") joins the same speaker's next sentence within this
    // many ms and is checked as one claim; a fragment is never checked on its own. "0" stops the joining only.
    "ASR_STITCH_MS": "4000",
    // Off unless an operator turns it on for a debugging session: "1" logs every final ASR result
    // with per-word confidence or logprob (what bystanders said). Never commit it as "1".
    "DEBUG_TRANSCRIPTS": ""
  }

  // Secrets, set with `npx wrangler secret put <NAME> --config ../../wrangler.jsonc` from deploy/cloudflare.
  // Never put their values in this file:
  //   JEV_API_KEY, EXA_API_KEY, ELEVENLABS_API_KEY, DEEPGRAM_API_KEY (fallback), GOOGLE_FACTCHECK_API_KEY (optional), DEMO_JOIN_CODE,
  //   DEMO_JOIN_EXPIRES_AT, ALLOWED_ORIGINS, DEBUG_FEED_KEY (optional, debugging only)
}
